# ──────────────────────────────────────────────────────────────────────────────
# MyBody365 — what docker-compose.yml (production) expects. Never commit a filled copy.
# On Coolify only the three first variables are entered by hand: the SERVICE_* ones are generated
# by Coolify on the first deployment and kept after.
# ──────────────────────────────────────────────────────────────────────────────

# Required. Google OAuth 2.0 client (https://console.cloud.google.com/apis/credentials), type "Web application".
# Authorised JavaScript origin: https://mybody365.mbonnici.fr
# Authorised redirect URIs:     https://mybody365.mbonnici.fr/api/auth/oauth2/code/google
#                               https://mybody365.mbonnici.fr/api/me/drive/callback   (Google Drive backups)
# For the backups, also enable "Google Drive API" and add the scope .../auth/drive.file to the consent screen
# (a non-sensitive scope: no Google verification needed). Drive refresh tokens are encrypted with a key derived
# from GOOGLE_CLIENT_SECRET: changing the secret only means members connect their Drive again.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required. The Google address(es) that are always admins, separated by ";" (e.g. you@gmail.com;other@gmail.com).
# Everyone else gets in through an access request approved by an admin.
ADMIN_EMAILS=

# Generated by Coolify. Outside Coolify, set long random values (openssl rand -hex 32), once:
# the database keeps the user and password it was created with.
SERVICE_USER_POSTGRES=
SERVICE_PASSWORD_64_POSTGRES=
# Object storage (SeaweedFS, the "storage" service): generated by Coolify too. Same rule: set once, keep.
SERVICE_USER_S3=
SERVICE_PASSWORD_64_S3=

# Optional.
# Storage allowed per account in MB (an admin can change it per account). Default 1024.
# STORAGE_QUOTA_MB=1024
# How the app names itself to Open Food Facts (they ask every client to; add a contact if you wish).
# OFF_USER_AGENT=MyBody365
