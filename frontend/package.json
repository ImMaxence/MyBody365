{
  "name": "mybody365",
  "version": "0.2.0",
  "private": true,
  "description": "MyBody365 — mobile-only PWA for a one-year body transformation (Angular 22)",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/changelog.mjs",
    "start": "ng serve --port 4300",
    "prebuild": "node scripts/changelog.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "pretest": "node scripts/changelog.mjs",
    "test": "ng test --watch=false",
    "icons": "node scripts/icons.mjs",
    "fonts": "node scripts/fonts.mjs",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report"
  },
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@angular/platform-server": "^22.2.6",
    "@angular/router": "^22.2.6",
    "@angular/service-worker": "^22.2.6",
    "@angular/ssr": "^22.2.7",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.12.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "sharp": "^0.34.5",
    "subset-font": "^2.9.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
