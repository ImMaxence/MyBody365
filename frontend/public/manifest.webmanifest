{
  "id": "/app",
  "name": "MyBody365",
  "short_name": "MyBody365",
  "description": "365 jours pour transformer ton corps : poids, photos, repas, flamme quotidienne.",
  "lang": "fr",
  "dir": "ltr",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone"
  ],
  "orientation": "portrait",
  "background_color": "#0a0a0c",
  "theme_color": "#0a0a0c",
  "categories": [
    "health",
    "fitness",
    "lifestyle"
  ],
  "share_target": {
    "action": "/app/meals/recipes/new",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Ajouter un repas",
      "short_name": "Repas",
      "url": "/app/meals/add",
      "icons": [
        {
          "src": "/icons/shortcut-meal.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Me peser",
      "short_name": "Pesée",
      "url": "/app?weigh=1",
      "icons": [
        {
          "src": "/icons/shortcut-weigh.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Photo du jour",
      "short_name": "Photo",
      "url": "/app/photos/camera",
      "icons": [
        {
          "src": "/icons/shortcut-photo.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ]
}
